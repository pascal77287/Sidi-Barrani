# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used as the canonical host for HTTPS redirects and as an allowed Socket.IO origin.
APP_URL="MY_APP_URL"

# ALLOWED_ORIGINS (optional): Comma-separated list of additional origins
# allowed to open a Socket.IO connection, e.g. "https://example.com,https://www.example.com".
# Same-origin requests are always allowed.
ALLOWED_ORIGINS=""

# HOST (optional): Interface to bind to. Defaults to 127.0.0.1 in dev mode
# and 0.0.0.0 in production. Set HOST=0.0.0.0 with `npm run dev` to test on a phone in the LAN.
HOST=""
